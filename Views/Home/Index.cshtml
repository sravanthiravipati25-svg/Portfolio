<!-- CONTACT SECTION -->
<section id="contact" class="py-5 section-dark">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="glass-panel p-5 tilt-card">
                    <div class="text-center mb-4 tilt-child">
                        <div class="section-badge mb-3">Get In Touch</div>
                        <h2 class="display-6 fw-bold text-white">Let's Build Something Scalable</h2>
                        <p class="text-light-emphasis">Available for .NET Full-Stack & Database Engineering opportunities.</p>
                    </div>

                    <form asp-action="Contact" method="post" class="tilt-child-deep">
                        @Html.AntiForgeryToken()

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label text-white"></label>
                                <input asp-for="Name" class="form-control form-control-lg dark-input" placeholder="Your Name" autocomplete="off"/>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label text-white"></label>
                                <input asp-for="Email" class="form-control form-control-lg dark-input" placeholder="your.email@example.com" autocomplete="off"/>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Message" class="form-label text-white"></label>
                                <textarea asp-for="Message" rows="5" class="form-control form-control-lg dark-input" placeholder="Your message..."></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>

                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-primary btn-lg px-5 py-3 glow-btn rounded-4 submit-btn">
                                    <span class="btn-text fw-bold">Send Message</span>
                                    <span class="btn-loader d-none">
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        Sending...
                                    </span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const alerts = document.querySelectorAll(".auto-hide-alert");

        alerts.forEach(alert => {
            setTimeout(() => {
                alert.classList.remove("show");
                alert.classList.add("hide");

                setTimeout(() => {
                    alert.remove();
                }, 500);
            }, 7000);
        });
    });
</script>